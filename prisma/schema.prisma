// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  USUARIO
  OPERADOR
  ADMINISTRADOR
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  email     String   @unique
  password  String
  rol       RolUsuario @default(USUARIO)
  reservas  Reserva[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habitacion {
  id             Int       @id @default(autoincrement())
  numero         Int       @unique
  piso           Int?
  tipo           String
  descripcion    String?
  capacidad      Int       @default(1)
  precioPorNoche Float
  estadoId       Int       @default(1) // Default to 'Libre'
  estado         EstadoHabitacion @relation(fields: [estadoId], references: [id])
  reservas       Reserva[]
  servicios      ServicioEnHabitacion[]
  imagenes       HabitacionImagen[] // Relación inversa a HabitacionImagen
  @@index([estadoId])
}

model Reserva {
  id              Int      @id @default(autoincrement())
  usuarioId       Int
  habitacionId    Int
  fechaInicio     DateTime
  fechaFin        DateTime
  numeroHuespedes Int      @default(1)
  
  estado          EstadoReserva @default(PENDIENTE) 

  createdAt       DateTime @default(now())
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  habitacion      Habitacion @relation(fields: [habitacionId], references: [id])
  pagos           Pago[]
  @@index([usuarioId])
  @@index([habitacionId])
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Pago {
  id             Int       @id @default(autoincrement())
  monto          Float
  estado         EstadoPago @default(PENDIENTE) // Usamos el Enum
  createdAt      DateTime  @default(now())

  // Relación con Reserva (como ya tenías)
  reservaId      Int
  reserva        Reserva   @relation(fields: [reservaId], references: [id])

  // Nueva relación con MetodoDePago
  metodoId       Int
  metodoDePago   MetodoDePago @relation(fields: [metodoId], references: [id])

  @@index([reservaId])
  @@index([metodoId])
}

enum EstadoPago {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
  RECHAZADO
}

model MetodoDePago {
  id     Int    @id @default(autoincrement())
  nombre String @unique // Ej: "Tarjeta de Crédito", "Efectivo", "Transferencia"
  pagos  Pago[]
}

model Servicio {
  id           Int                    @id @default(autoincrement())
  nombre       String                 @unique
  descripcion  String?
  habitaciones ServicioEnHabitacion[]
}

model ServicioEnHabitacion {
  habitacion   Habitacion @relation(fields: [habitacionId], references: [id])
  habitacionId Int
  servicio     Servicio   @relation(fields: [servicioId], references: [id])
  servicioId   Int
  @@id([habitacionId, servicioId])
}

model Consulta {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  mensaje   String
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HabitacionImagen {
  id           Int      @id @default(autoincrement())
  url          String
  altText      String?
  habitacionId Int
  habitacion   Habitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
  @@index([habitacionId])
}

model EstadoHabitacion {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  habitaciones Habitacion[]
}
